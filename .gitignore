# Material de apoio (ppts, PDFs) - nao versionado
doc/

# Referencias de material para preparo do curso - nao versionado
referencias/

# Build artifacts
build*/
*.hex
*.zip
# ... exceto os hex de referencia de cada passo (edge_ai/hex/build_all.py)
!edge_ai/hex/*.hex
# ... e os do modulo de Comunicacao (comms/hex/build_all.py). So os PUBLICOS:
# os que levam credencial de rede saem em build/hex/_local/ e nao entram aqui.
!comms/hex/*.hex
# ... e os do modulo de GNSS (gnss/hex/build_all.py). Todas as variantes sao
# publicas: nenhuma leva credencial, e a coordenada de referencia fica vazia.
!gnss/hex/*.hex

# IDE / editor
.vscode/
*.code-workspace

# Python
__pycache__/
*.pyc
.venv/

# Configuracao local do Claude Code - nao versionada
.claude/
