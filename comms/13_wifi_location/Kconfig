menu "Lab: locationing por scan de Wi-Fi (nrf-manaus-2)"

config LAB_PORTA
	int "Porta do servidor no PC (padrao do prompt do boot)"
	default 9000
	help
	  O IP do servidor e digitado no terminal no primeiro boot e gravado em
	  settings (src/lab_rede.c); esta e a porta que o prompt propoe, e Enter
	  aceita. Porta TCP onde tools/wifi_locate.py escuta a lista de pontos de
	  acesso vinda do kit. Precisa bater com o --porta passado ao
	  wifi_locate.py.

endmenu

source "Kconfig.zephyr"
