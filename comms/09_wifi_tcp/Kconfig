menu "Lab: telemetria por socket (nrf-manaus-2)"

config LAB_SERVIDOR_IP
	string "IP do servidor no PC"
	default ""
	help
	  IPv4 do PC que roda o tools/wifi_server.py. Vazio faz o build falhar.

config LAB_PORTA
	int "Porta TCP do servidor"
	default 9000

config LAB_INTERVALO_MS
	int "Intervalo entre amostras de telemetria (ms)"
	default 2000
	range 200 60000

choice LAB_TRANSPORTE
	prompt "Transporte"
	default LAB_TRANSPORTE_TCP
	help
	  O mesmo payload sai pelos tres. Ver o lab 10 para a comparacao.

config LAB_TRANSPORTE_TCP
	bool "TCP puro"

endchoice

endmenu

source "Kconfig.zephyr"
